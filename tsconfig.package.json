{
  // 宽松档：多数发布包共用这一份 compilerOptions。
  //
  // 这些包目前只开了 noImplicitAny，严格度收紧属于独立的重构。
  // 把 18 份一模一样的 compilerOptions 收在这里，包内 tsconfig 只留 extends 与 include，
  // 想收紧严格度的包改成 extends "../tsconfig.base.json"（snippets / install-package /
  // inline-elements 就是这样）。
  //
  // 注意：include 不能写在这里。TS 的 include / exclude / files 相对「声明它们的那个
  // 配置文件」解析，写在这里会指向仓库根的 src/，落到每个包上就成了空集合。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": true,
    // 依赖 strictNullChecks，本档当前关着
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  }
}
