{
  "json.schemas": [
    {
      "fileMatch": ["/plugins/*/manifest.json", "/themes/*/manifest.json", "/widgets/*/manifest.json"],
      "url": "./manifests/override.schema.json"
    },
    {
      "fileMatch": ["/manifests/base.json"],
      "url": "./manifests/base.schema.json"
    },
    {
      "fileMatch": ["/dist/*/plugin.json", "/dist/*/theme.json", "/dist/*/widget.json"],
      "url": "./manifests/dist.schema.json"
    }
  ],
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/dist": true
  },
  "js/ts.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/dist"]
  }
}
