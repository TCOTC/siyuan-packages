{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 320,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "experimentalOperatorPosition": "start",
  "objectWrap": "preserve",
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": ["dist/**", "package.zip", "**/*.yml", "**/*.yaml"]
}
