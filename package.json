{
  "name": "siyuan-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "思源集市包单一源码仓库：插件 / 主题 / 挂件统一构建，构建产物分发到各自的集市收录仓库",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "create:plugin": "siyuan-kit create",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "siyuan-kit check",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@jeffrey-chen/siyuan-kit": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
